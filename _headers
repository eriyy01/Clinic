/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://maps.google.com https://www.google.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://maps.google.com https://www.google.com https://maps.gstatic.com; frame-src https://maps.google.com https://www.google.com; connect-src 'self' https://wa.me; form-action 'self' https://wa.me; base-uri 'self'; object-src 'none'
